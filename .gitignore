# Audio lane working directory: raw TTS renders, normalisation
# intermediates, voice-probe scratch and measurement scratch. The DELIVERED
# files live in Content/Audio/ and the contract in
# Content/Audio/Insults/insults_manifest.json; everything here is
# regenerable and must never be committed.
.audio_work/

# Blender temp
*.blend1

# regenerable Blender render working dirs (published evidence lives in CommandCenter/outputs)
Tools/blender/out_lighting/
Tools/blender/out_lighting_build/
Tools/blender/out_textures/
Tools/blender/out_xcom_build/

# Live output-server log (held open by the running server; never commit)
CommandCenter/serve_outputs.log

